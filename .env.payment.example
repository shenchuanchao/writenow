# ============================================================
# 免签支付配置示例
# 复制此文件为 .env.local，填入你的免签平台密钥
# ============================================================

# ========== 支付平台配置（必填）==========

# 商户ID - 在你的免签支付平台后台获取
PAYMENT_MERCHANT_ID=

# API密钥 - 在你的免签支付平台后台获取
PAYMENT_API_KEY=

# 支付网关地址 - 第三方支付平台 API 根地址
# 不同平台地址不同，请参考你使用的平台文档
# 示例：https://api.xxx-pay.com
PAYMENT_GATEWAY_URL=

# 回调地址（外网可访问的地址）
# 部署到 Vercel 后填入你的实际域名，例如：https://your-domain.vercel.app
PAYMENT_NOTIFY_URL=https://your-domain.com/api/payment/callback

# 支付完成返回地址（用户扫码后跳转的页面）
PAYMENT_RETURN_URL=https://your-domain.com/profile

# 签名方式：md5 或 sha256（根据你的支付平台选择）
PAYMENT_SIGN_TYPE=md5